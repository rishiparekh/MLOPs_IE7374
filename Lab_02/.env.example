# Copy to .env (setup.sh does this for you).

AIRFLOW_UID=50000

AQ_LOCATION_NAME=Boston, MA
AQ_LATITUDE=42.3601
AQ_LONGITUDE=-71.0589
AQ_HORIZON_HOURS=1

# Leave empty to disable email.
AQ_ALERT_EMAIL=

# Gmail app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=

AIRFLOW_JWT_SECRET=change-me
