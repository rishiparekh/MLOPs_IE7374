# Copy to .env (setup.sh does this for you) and edit as needed.

# Must match your host user id so bind-mounted directories stay writable.
AIRFLOW_UID=50000

# Where to forecast. Defaults are Boston, MA.
AQ_LOCATION_NAME=Boston, MA
AQ_LATITUDE=42.3601
AQ_LONGITUDE=-71.0589

# How many hours ahead to predict PM2.5.
AQ_HORIZON_HOURS=1

# Notification recipient. Leave empty to disable email entirely -- the
# callbacks log a warning and move on rather than failing the task.
AQ_ALERT_EMAIL=

# Gmail app password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=

# Change this for anything that is not a local lab.
AIRFLOW_JWT_SECRET=please-change-me-in-a-real-deployment
